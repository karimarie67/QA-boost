name: QA Test Suite - Boost.org

on:
  # Smoke tests on every PR and commit (pre-merge validation)
  pull_request:
    branches: [ main, develop ]
  push:
    branches: [ main, develop ]
  
  # Manual trigger with environment selection
  workflow_dispatch:
    inputs:
      environment:
        description: 'Test environment'
        required: true
        default: 'staging'
        type: choice
        options:
          - staging
          - production
      test_suite:
        description: 'Test suite to run'
        required: true
        default: 'all'
        type: choice
        options:
          - smoke
          - regression
          - all

env:
  TEST_ENV: ${{ github.event.inputs.environment || 'staging' }}

jobs:
  # SMOKE TESTS - Run on ALL commits/PRs (fast feedback)
  smoke-tests:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    name: Smoke Tests (Quick Validation)
    # Run smoke tests on PRs and all pushes
    if: github.event_name == 'pull_request' || github.event_name == 'push' || github.event.inputs.test_suite == 'smoke' || github.event.inputs.test_suite == 'all'
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          
      - name: Install dependencies
        run: npm ci
        
      - name: Install Playwright Browsers
        run: npx playwright install --with-deps chromium
        
      - name: Run Smoke Tests
        run: npx playwright test smoke_tests.spec.js --reporter=json,html > smoke-results.json || true
        continue-on-error: true
        
      - name: Upload Smoke Test Results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: smoke-test-results
          path: |
            smoke-results.json
            playwright-report/
            test-results/
          retention-days: 30
          
      - name: Comment PR with Smoke Results
        if: github.event_name == 'pull_request' && always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            let results = 'Smoke tests completed!';
            try {
              if (fs.existsSync('smoke-results.json')) {
                const data = JSON.parse(fs.readFileSync('smoke-results.json', 'utf8'));
                const total = data.suites?.reduce((acc, s) => acc + (s.specs?.length || 0), 0) || 0;
                results = `🔥 **Smoke Tests Results:**\n- Total: ${total} tests\n- Check the Actions tab for details`;
              }
            } catch (e) {
              results = '🔥 Smoke tests ran - check Actions for results';
            }
            
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: results
            });

  # REGRESSION TESTS - Only run on develop branch (after merge)
  regression-tests:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    name: Regression Tests (Full Validation)
    # Only run regression on develop branch OR manual trigger
    if: (github.event_name == 'push' && github.ref == 'refs/heads/develop') || github.event.inputs.test_suite == 'regression' || github.event.inputs.test_suite == 'all'
    needs: smoke-tests
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          
      - name: Install dependencies
        run: npm ci
        
      - name: Install Playwright Browsers
        run: npx playwright install --with-deps
        
      - name: Run Boost.io Regression Tests
        run: npx playwright test boost_io_tests.spec.js --reporter=json,html > boost-io-results.json || true
        continue-on-error: true
        
      - name: Upload Boost.io Test Results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: boost-io-test-results
          path: |
            boost-io-results.json
            playwright-report/
            test-results/
          retention-days: 30

  version-regression-tests:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    name: Version Regression Tests
    # Only run on develop OR manual trigger
    if: (github.event_name == 'push' && github.ref == 'refs/heads/develop') || github.event.inputs.test_suite == 'regression' || github.event.inputs.test_suite == 'all'
    needs: smoke-tests
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          
      - name: Install dependencies
        run: npm ci
        
      - name: Install Playwright Browsers
        run: npx playwright install --with-deps
        
      - name: Run Version Tests
        run: npx playwright test boost_version_tests.spec.js --reporter=json,html > version-results.json || true
        continue-on-error: true
        
      - name: Upload Version Test Results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: version-test-results
          path: |
            version-results.json
            playwright-report/
            test-results/
          retention-days: 30

  # UPDATE DASHBOARD - After all tests complete
  update-dashboard:
    runs-on: ubuntu-latest
    needs: [smoke-tests, regression-tests, version-regression-tests]
    if: always()
    name: Update QA Dashboard
    permissions:
      contents: write
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: ./artifacts
        continue-on-error: true
        
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          
      - name: Generate Dashboard
        run: |
          node dashboards/scripts/generate-dashboard.js
        env:
          TEST_ENV: ${{ env.TEST_ENV }}
          GITHUB_RUN_ID: ${{ github.run_id }}
          GITHUB_RUN_NUMBER: ${{ github.run_number }}
          GITHUB_REF: ${{ github.ref }}
          
      - name: Commit Dashboard Updates
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          git add dashboards/
          git diff --quiet && git diff --staged --quiet || (git commit -m "📊 Update QA Dashboard - Run #${{ github.run_number }} [${{ github.ref_name }}]" && git push)

  # QUALITY GATE - Fail the build if smoke tests fail on PRs
  quality-gate:
    runs-on: ubuntu-latest
    needs: smoke-tests
    if: github.event_name == 'pull_request'
    name: Quality Gate Check
    
    steps:
      - name: Download smoke test results
        uses: actions/download-artifact@v4
        with:
          name: smoke-test-results
        continue-on-error: true
        
      - name: Check smoke test results
        run: |
          if [ -f "smoke-results.json" ]; then
            # Parse results and fail if critical tests failed
            # For now, we'll pass - customize this based on your needs
            echo "✅ Quality gate passed"
          else
            echo "⚠️ No smoke test results found"
            exit 1
          fi
